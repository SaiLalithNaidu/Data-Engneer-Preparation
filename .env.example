# DATA ENGINEER PREPARATION SUITE - DATABASE & BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and enter your database credentials below:

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. Database Type (sqlite, postgres, mysql, mongodb)
DB_TYPE=sqlite

# 3. Database Credentials (For PostgreSQL / MySQL / Production DBs)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=data_engineer_prep_db

# 4. Authentication Secret Key
JWT_SECRET=de_prep_super_secret_jwt_key_2026

# 5. Local Data Storage File (For SQLite / Embedded File DB)
DB_FILE_PATH=./server/data_store.json
