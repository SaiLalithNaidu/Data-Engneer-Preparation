# NGINX Configuration for AWS EC2 Deployment
# Place in /etc/nginx/sites-available/data-eng-prep

server {
    listen 80;
    server_name YOUR_EC2_PUBLIC_IP; # Replace with your EC2 Public IP or Domain

    # Max upload file size
    client_max_body_size 50M;

    # 1. Serve React Frontend Static Files
    location / {
        root /var/www/Data-Engneer-Preparation/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # 2. Reverse Proxy API Requests to Express Backend (Port 5000)
    location /api/ {
        proxy_pass http://127.0.0.1:5000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
